# Copie para .env.local. Valores do Supabase local: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (jobs e seed). Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# App da Meta (Instagram API com login do Instagram). Só no servidor.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://SEU-DOMINIO/api/meta/oauth/callback
META_GRAPH_VERSION=v24.0
# Só para testes com a Meta simulada. Deixe vazio em produção.
META_GRAPH_BASE_URL=

# Segredos aleatórios com 32+ caracteres (ex.: `openssl rand -base64 48`)
OAUTH_STATE_SECRET=
CRON_SECRET=
