# Copie para .env.local. Valores do Supabase local: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (jobs e seed). Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# App da Meta (Instagram API com login do Instagram). Só no servidor.
# Opcional enquanto se publica pelo Metricool.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://SEU-DOMINIO/api/meta/oauth/callback
META_GRAPH_VERSION=v24.0
# Só para testes com a Meta simulada. Deixe vazio em produção.
META_GRAPH_BASE_URL=

# Endereço público do app (ex.: https://visus-publish.vercel.app). Usado no retorno do login do Metricool.
APP_URL=

# Metricool: o token de cada cliente fica no Vault (tela Contas), não aqui.
# Só para testes com o Metricool simulado. Deixe vazio em produção.
METRICOOL_BASE_URL=
METRICOOL_MCP_URL=
# IA (opcional): só para testes com provedor simulado; em produção fica vazio
OPENAI_BASE_URL=
GEMINI_BASE_URL=
HIGGSFIELD_BASE_URL=

# Segredos aleatórios com 32+ caracteres (ex.: `openssl rand -base64 48`)
OAUTH_STATE_SECRET=
CRON_SECRET=
